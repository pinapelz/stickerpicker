# Matrix homeserver URL (without trailing slash)
MATRIX_HOMESERVER=https://chat.moekyun.me

# Matrix Client-Server API Bearer access token
MATRIX_ACCESS_TOKEN=syt_your_access_token_here

# Comma-separated list of Matrix room IDs.
# The first room ID is used as the primary room for storing shared room sticker packs.
MATRIX_ROOM_IDS=!primaryroom:moekyun.me,!secondaryroom:moekyun.me

# Output directory for Maunium stickerpicker pack JSON files
PACKS_DIR=./web/packs
